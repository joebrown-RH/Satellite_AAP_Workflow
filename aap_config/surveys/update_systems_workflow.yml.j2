---
name: Update Systems
description: Patch the selected hosts. Use the Patch Group and Host Group fields to
  target a host group or patch group.
spec:
  - question_name: Patch Group
    type: multiplechoice
    question_description: Which patch group to update
    variable: patch_group
    required: true
    default: '1'
    choices: {{ sat_patch_groups }}

  - question_name: Host Group
    type: text
    question_description: Which host group to update
    variable: host_group
    required: true
    default: None

  - question_name: Restart policy
    question_description: least = reboot only if the kernel or a core library changed,
      otherwise restart just the affected services. always = reboot every host unconditionally.
    variable: reboot
    type: multiplechoice
    choices:
      - least
      - always
    default: least
    required: true
