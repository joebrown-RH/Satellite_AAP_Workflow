{
  "name": "Update Systems",
  "description": "Promote content to a lifecycle environment, then patch the hosts in it. Use the Limit field on launch to target a host group or patch group.",
  "spec": [
    {
      "question_name": "Target lifecycle environment",
      "question_description": "Content is promoted from this environment's prior step into this one, and the errata reports are scoped to it.",
      "variable": "lifecycle_environment",
      "type": "multiplechoice",
      "choices": [
{% for env in sat_lifecycle_environments %}
        {{ env | to_json }}{{ "," if not loop.last }}
{% endfor %}
      ],
      "default": {{ sat_lifecycle_environments | first | to_json }},
      "required": true
    },
    {
      "question_name": "Restart policy",
      "question_description": "least = reboot only if the kernel or a core library changed, otherwise restart just the affected services. always = reboot every host unconditionally.",
      "variable": "reboot",
      "type": "multiplechoice",
      "choices": ["least", "always"],
      "default": "least",
      "required": true
    }
  ]
}
