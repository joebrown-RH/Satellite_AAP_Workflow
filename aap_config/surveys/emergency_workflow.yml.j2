---
name: Emergency Publish
description: >-
  Push specific errata out ahead of the normal patch window and apply them.
  Use the Limit field on launch to target a host group or patch group.
spec:
  - question_name: Errata IDs
    question_description: >-
      One advisory per line, e.g. RHSA-2026:73979. These become
      the include rules on the emergency content view's errata filter.
    variable: errata_ids
    type: textarea
    default: ''
    required: true

  - question_name: Lifecycle environment
    question_description: >-
      The environment the errata reports are scoped to.
    variable: lifecycle_environment
    type: multiplechoice
    choices: {{ ['Library'] + (sat_lifecycle_environments | json_query('[].name')) }}
    default: {{ sat_lifecycle_environments | json_query('[].name') | first | to_json }}
    required: true

  - question_name: Host Group
    type: text
    question_description: Which host group to update
    variable: host_group
    required: true
    default: ""

  - question_name: Restart policy
    question_description: >-
      least = reboot only if the kernel or a core library changed,
      otherwise restart just the affected services. always = reboot every host unconditionally.
    variable: reboot
    type: multiplechoice
    choices:
      - least
      - always
    default: least
    required: true
