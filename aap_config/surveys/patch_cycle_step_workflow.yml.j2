---
name: Patch Cycle Step
description: >-
  Promote content to a lifecycle environment, then patch the hosts in it.
  Use the Patch Group and Host Group fields to target a host group or patch group.
spec:
  - question_name: Target lifecycle environment
    question_description: >-
      Content is promoted from this environment's prior step into
      this one, and the errata reports are scoped to it.
    variable: lifecycle_environment
    type: multiplechoice
    choices: {{ ['Library'] + (sat_lifecycle_environments | json_query('[].name')) }}
    default: {{ sat_lifecycle_environments | json_query('[].name') | first | to_json }}
    required: true

  - question_name: Patch Group
    type: multiplechoice
    question_description: Which patch group to update
    variable: patch_group
    required: true
    default: {{ sat_patch_groups | first | string | to_json }}
    choices: {{ sat_patch_groups }}

  - question_name: Host Group
    type: text
    question_description: Which host group to update
    variable: host_group
    required: true
    default: ""

  - question_name: Restart policy
    question_description: >-
      least = reboot only if the kernel or a core library changed,
      otherwise restart just the affected services. always = reboot every host unconditionally.
    variable: reboot
    type: multiplechoice
    choices:
      - least
      - always
    default: least
    required: true
