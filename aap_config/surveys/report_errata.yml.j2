---
name: Report Installable Errata
description: Scope the errata report.
spec:
  - question_name: Lifecycle environment
    question_description: The environment the report is relative to.
    variable: lifecycle_environment
    type: multiplechoice
    choices: {{ sat_lifecycle_environments | json_query('[].name') }}
    default: {{ sat_lifecycle_environments | json_query('[].name') | first | quote }}
    required: true

  - question_name: Report against the prior environment
    question_description: |-
      true = show what is waiting to be installed from the step before the chosen environment (use this for the BEFORE report).
      false = report against the chosen environment itself (use this for the AFTER report, which should come back empty).
    variable: lifecycle_prior
    type: multiplechoice
    choices:
      - 'true'
      - 'false'
    default: 'true'
    required: true

  - question_name: Host Group
    question_description: Which host group should the report include
    type: text
    variable: host_group
    required: false

  - question_name: Host Query
    question_description: Define a custom limit instead of the built-in filtering that utilizes Host Group and Patch Group
    type: text
    variable: host_query
    required: false
